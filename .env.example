# ---------------------------------------------------------------------------------------------
# Supabase — a NEW project for this portal (not wa-portal's, not VTracker's).
# Project Settings -> Data API / API Keys
# ---------------------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnop.supabase.co

# The PUBLISHABLE key. Browser-safe: used for signing in and for screenshot uploads to a
# one-time signed slot. Every table denies it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ⚠⚠ The SECRET key, never NEXT_PUBLIC_. It bypasses RLS. The portal refuses to start on the
# wrong kind of key, because a publishable key here returns empty lists rather than an error.
SUPABASE_SECRET_KEY=sb_secret_...

# ---------------------------------------------------------------------------------------------
# Who runs it
# ---------------------------------------------------------------------------------------------
# Administrators who may sign in before anyone has been added. On first sign-in each gets a
# testers row marked admin. Everyone else is added on the Testers page — not here.
PORTAL_ADMIN_EMAILS=wyne.chitambara@totalretailzw.com

# Where sign-in links come back to. Set it in production. ⚠ It must ALSO be listed in Supabase
# under Authentication -> URL Configuration -> Redirect URLs as <origin>/** — Supabase silently
# swaps an unlisted address for the Site URL, which starts life as http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://vantage-uat.vercel.app
